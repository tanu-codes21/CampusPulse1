# CampusPulse Environment Variables
# Copy this file to .env.local and fill in your keys

# Supabase Credentials (PostgreSQL, Auth with OTP, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini API Key (For Smart Notice Extraction, Summarization, Hindi Translation & Campus AI Assistant)
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

